rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }

    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        || (request.auth != null
          && request.resource.data.approved == false
          && request.resource.data.active == false
          && request.resource.data.registrationSource == "self");
      allow update: if isAdmin()
        || (request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['passwordHash','password','passwordUpdatedAt','passwordAdminVisible']));
      allow delete: if isAdmin();
    }

    match /studentCredentials/{studentId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /classCredentials/{classId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /examPublic/{examId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /examSecrets/{examId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /timeSync/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['serverAt'])
        && request.resource.data.serverAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /examAttempts/{attemptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.studentId is string
        && request.resource.data.examId is string
        && request.resource.data.createdByAuthUid == request.auth.uid
        && (request.resource.data.status == "in_progress"
          || request.resource.data.status == "completed");

      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.createdByAuthUid == request.auth.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.examId == resource.data.examId
          && request.resource.data.createdByAuthUid == resource.data.createdByAuthUid
          && resource.data.status == "in_progress"
          && (
            (request.resource.data.status == "in_progress"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['violationCount','violationLog','updatedAt']))
            || request.resource.data.status == "completed"
          ));
      allow delete: if isAdmin();
    }

    // V17: nilai ujian.
    // Penulisan/publikasi hanya admin.
    match /examScores/{scoreId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
