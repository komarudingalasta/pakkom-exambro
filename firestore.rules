rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function hasStudentSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/studentSessions/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }

    match /classes/{classId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /studentSessions/{uid} {
      allow read, write: if false;
    }

    match /classAccess/{id} {
      allow read, write: if false;
    }

    match /examPublic/{examId} {
      allow read: if isAdmin() || hasStudentSession();
      allow create, update, delete: if isAdmin();
    }

    match /examSecrets/{examId} {
      allow read, write: if isAdmin();
    }

    match /examAttempts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
