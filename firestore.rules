rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }

    match /students/{studentId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.approved == false
        && request.resource.data.active == false
        && request.resource.data.registrationSource == "self";

      allow delete: if isAdmin();

      // V16 Lite: siswa dapat mengganti sandi setelah login aplikasi.
      // Arsitektur Lite belum mengikat dokumen siswa ke Firebase UID secara permanen,
      // sehingga versi Secure/Cloud Functions tetap direkomendasikan untuk produksi penuh.
      allow update: if isAdmin()
        || (request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['passwordHash', 'password', 'passwordUpdatedAt']));
    }

    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /examPublic/{examId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /examSecrets/{examId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Sinkronisasi jam terhadap Firestore server time.
    // Setiap user hanya dapat menulis dokumen dengan ID UID Firebase miliknya.
    match /timeSync/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['serverAt'])
        && request.resource.data.serverAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /examAttempts/{attemptId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.studentId is string
        && request.resource.data.examId is string
        && request.resource.data.createdByAuthUid == request.auth.uid
        && (request.resource.data.status == "in_progress"
            || request.resource.data.status == "completed");

      // Admin dapat mengelola/reset attempt.
      // Siswa pemilik sesi dapat:
      // 1) menambahkan violationCount/violationLog saat masih in_progress;
      // 2) menyelesaikan attempt miliknya.
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.createdByAuthUid == request.auth.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.examId == resource.data.examId
          && request.resource.data.createdByAuthUid == resource.data.createdByAuthUid
          && resource.data.status == "in_progress"
          && (
            (
              request.resource.data.status == "in_progress"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['violationCount', 'violationLog', 'updatedAt'])
            )
            || request.resource.data.status == "completed"
          ));

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
